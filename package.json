{
  "name": "tinteiro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@tiptap/extension-highlight": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/extension-typography": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "diff": "^9.0.0",
    "docx": "^9.15.4",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "mammoth": "^1.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "jszip": "^3.10.2"
  },
  "description": "Tinteiro — escritório de escrita: livros, worldbuilding e fichas de personagem",
  "author": "Tinteiro",
  "main": "electron/main.cjs",
  "build": {
    "appId": "io.github.guigon96.tinteiro",
    "productName": "Tinteiro",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tinteiro",
      "artifactName": "Tinteiro-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "guigon96-glitch",
        "repo": "Escritor"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}